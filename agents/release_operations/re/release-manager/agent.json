{
  "$schema": "https://floworkos.com/schemas/agent.v2.json",
  "schema_version": "2.0.0",
  "id": "release-manager",
  "agent_id": "agent-release-01",
  "name": "Release Manager & Packaging Specialist",
  "icon": "🚀",
  "description": "Release operations specialist managing Semantic Versioning, automated changelogs, Agile-V preflight release gates, progressive canary rollouts, and cryptographic artifact provenance.",
  "category": "release_operations",
  "priority": 93,
  "pinned_model": {
    "model_id": "gemini-3.8-flash-high",
    "provider": "google",
    "enforce_lock": false
  },
  "pinned_account": {
    "account_id": "combo",
    "pool_strategy": "combo"
  },
  "desk_preference": {
    "zone": "Release & Operations Deck",
    "desk_id": "desk-release-manager"
  },
  "default_tools": [
    "run_command",
    "view_file",
    "write_to_file",
    "replace_file_content",
    "ask_question"
  ],
  "slash_commands": [
    {
      "command": "/release",
      "description": "Execute full end-to-end release ceremony including preflight verification, changelog, and tagging",
      "icon": "🚀"
    },
    {
      "command": "/preflight",
      "description": "Run comprehensive pre-release sanity checklist asserting clean git state, passing tests, and no debug artifacts",
      "icon": "🛡️"
    },
    {
      "command": "/semver",
      "description": "Calculate semantic version bump (Major, Minor, Patch) based on breaking changes and Conventional Commits",
      "icon": "🔢"
    },
    {
      "command": "/changelog",
      "description": "Synthesize Keep-a-Changelog compliant release notes categorized by Added, Changed, Fixed, and Security",
      "icon": "📝"
    },
    {
      "command": "/rollback",
      "description": "Execute automated rollback playbook restoring previous stable deployment within 60 seconds",
      "icon": "⏪"
    }
  ],
  "file_patterns": [
    "CHANGELOG.md",
    "VERSION",
    "package.json",
    "Cargo.toml",
    "release_checksums.json",
    "dist/**",
    "build/**",
    "release/**",
    "deploy/**"
  ],
  "keywords": [
    "release manager",
    "packaging specialist",
    "semantic versioning",
    "semver bump",
    "automated changelog",
    "keep a changelog",
    "conventional commits",
    "preflight release gate",
    "dirty tree check",
    "immutable git tag",
    "human signoff gate",
    "canary rollout",
    "blue green deployment",
    "automated rollback",
    "release checksums",
    "sha256 digest",
    "binary stripping",
    "supply chain security",
    "slsa provenance",
    "multi manifest sync"
  ],
  "exclude_keywords": [
    "forex",
    "trading crypto",
    "seo marketing",
    "youtube channel",
    "music production",
    "frontend styling",
    "raw assembly",
    "kernel panic"
  ],
  "department": "engineering"
}
