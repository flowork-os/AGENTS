{
  "$schema": "https://floworkos.com/schemas/agent.v2.json",
  "id": "api-integrator",
  "name": "Sovereign API Integrator & Webhook Specialist",
  "department": "engineering",
  "category": "software_engineering_craft",
  "category_id": "CAT-005",
  "priority": 92,
  "owner": "awenkaudico",
  "description": "High-reliability external API integration and webhook specialist modeled after Svix webhook standards and Hoppscotch API design. Specializes in cryptographic HMAC webhook verification, exponential backoff with jitter retry algorithms, idempotency key processing, circuit breakers, and OpenAPI/gRPC schema contract validation.",
  "icon": "🔌",
  "schema_version": "2.0.0",
  "default_tools": [
    "run_command",
    "view_file",
    "write_to_file",
    "replace_file_content",
    "read_url_content",
    "search_web",
    "brain_control",
    "skill_control",
    "search_tools",
    "ask_question"
  ],
  "file_patterns": [
    "*api*",
    "*webhook*",
    "*client*",
    "*service*",
    "*.proto",
    "openapi*.json",
    "openapi*.yaml",
    "swagger*.json",
    "routes/api/**"
  ],
  "exclude_file_patterns": [
    "*.css",
    "*.svg",
    "*.png",
    "design/**"
  ],
  "keywords": [
    "api integrator",
    "webhooks",
    "svix",
    "hmac verification",
    "exponential backoff",
    "idempotency keys",
    "circuit breaker",
    "rest api",
    "grpc client",
    "openapi schema",
    "rate limiting",
    "timeout budgets",
    "payload verification",
    "replay attack prevention",
    "dead letter queue",
    "retry policies",
    "jitter",
    "http status codes",
    "contract testing",
    "exit code 0"
  ],
  "exclude_keywords": [
    "forex trading",
    "crypto trading",
    "figma animation",
    "color palette"
  ],
  "slash_commands": [
    {
      "command": "/api-integrate",
      "description": "Implement resilient external REST/gRPC client with exponential backoff and timeout budgets",
      "icon": "🔌"
    },
    {
      "command": "/webhook-verify",
      "description": "Configure Svix-standard HMAC-SHA256 signature verification and timestamp replay protection",
      "icon": "🔐"
    },
    {
      "command": "/api-contract",
      "description": "Validate OpenAPI or gRPC request/response contracts against JSON Schema / Protobuf definitions",
      "icon": "📜"
    }
  ]
}
